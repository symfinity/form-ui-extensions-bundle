{
    "name": "symfinity/form-ui-extensions-bundle",
    "description": "Theme-agnostic Symfony Form UI extensions for metadata, novalidate strategy, and optional uppercase normalization",
    "license": "MIT",
    "homepage": "https://github.com/symfinity/form-ui-extensions-bundle",
    "support": {
        "issues": "https://github.com/symfinity/form-ui-extensions-bundle/issues",
        "source": "https://github.com/symfinity/form-ui-extensions-bundle",
        "docs": "https://github.com/symfinity/form-ui-extensions-bundle/tree/main/docs"
    },
    "authors": [
        {
            "name": "Symfinity",
            "email": "dev@symfinity.net",
            "homepage": "https://symfinity.net/"
        }
    ],
    "keywords": [
        "symfony",
        "symfony-bundle",
        "symfony-form",
        "forms",
        "ux-blocks",
        "form-theme",
        "twig",
        "design-system"
    ],
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "symfinity/ux-blocks-form": "^0.1",
        "symfony/config": "^7.4||^8.0",
        "symfony/dependency-injection": "^7.4||^8.0",
        "symfony/form": "^7.4||^8.0",
        "symfony/http-kernel": "^7.4||^8.0",
        "symfony/options-resolver": "^7.4||^8.0",
        "symfony/twig-bundle": "^7.4||^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0",
        "symfony/validator": "^7.4||^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfinity/ui-kernel": "^0.2",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-csrf": "^7.4||^8.0",
        "symfony/stimulus-bundle": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Symfinity\\FormUiExtensionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfinity\\FormUiExtensionsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "suggest": {
        "symfinity/ux-blocks-live": "Optional live date/tags widgets when symfinity_form_ui.theme.live_* is enabled"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "symfony": {
            "require": "^7.4||^8.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
