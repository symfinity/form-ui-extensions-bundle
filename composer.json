{
    "name": "symfinity/form-ui-extensions-bundle",
    "description": "Theme-agnostic Symfony Form UI extensions for metadata, novalidate strategy, and optional uppercase normalization",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "symfinity/ux-blocks-core": "^0.1",
        "symfinity/ux-blocks-form": "^0.1",
        "symfony/config": "^7.4||^8.0",
        "symfony/dependency-injection": "^7.4||^8.0",
        "symfony/form": "^7.4||^8.0",
        "symfony/http-kernel": "^7.4||^8.0",
        "symfony/options-resolver": "^7.4||^8.0",
        "symfony/twig-bundle": "^7.4||^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0",
        "symfony/validator": "^7.4||^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfinity/ui-kernel": "@dev",
        "symfony/framework-bundle": "^7.4",
        "symfony/stimulus-bundle": "^2.0|^3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ux-blocks-core",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../ux-blocks-form",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../ui-kernel",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Symfinity\\FormUiExtensionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfinity\\FormUiExtensionsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "suggest": {
        "symfinity/ux-blocks-live": "Optional live date/tags widgets when symfinity_form_ui.theme.live_* is enabled"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "symfony": {
            "require": "^7.4||^8.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
